        FE["Frontend (Nginx:80)"]
    end

    GW["API Gateway — KrakenD :8080"]

    subgraph Stress["Stress test"]
        direction LR
        K6[k6]
        LOC[locust]
    end

    subgraph Obs["Observabilité"]
        direction TB
        GF[Grafana] -->|PromQL| PR[Prometheus]
    end

    FE -->|HTTPS| GW
    K6 -->|HTTP| GW
    LOC -->|HTTP| GW

