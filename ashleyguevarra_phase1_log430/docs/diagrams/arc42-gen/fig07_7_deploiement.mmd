        TRF["transfer-service — ×2 a,b :8080"]
        PGA[("PostgreSQL account :5435")]
        PGT[("PostgreSQL transfer :5436")]
        RDS["Redis :6379"]
        NL -->|customers / accounts| ACC
        NL -->|transfers| TRF
        ACC --> PGA
        TRF --> PGT
        TRF --> RDS
        TRF -->|/internal/saga/* → account-a| ACC
